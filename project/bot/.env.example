# Скопируйте этот файл в .env и заполните. Файл .env НЕ публикуйте и не коммитьте.

# --- обязательно ---
# Токен бота от @BotFather
BOT_TOKEN=
# Ваш числовой Telegram ID (узнать: бот @userinfobot). Только этот ID может выдавать файлы
# и получает еженедельную сводку (понедельник 10:00 МСК). С клиентами общается только Виктория (ИИ).
OWNER_ID=
# Присылать вам уведомление, когда срабатывает кризисный сценарий: 1 — да, 0 — нет (по умолчанию).
# Клиент в любом случае сразу получает фиксированный текст с 8-800-2000-122 и 112.
NOTIFY_OWNER_ON_CRISIS=0

# --- оплата (только https://) ---
PAY_LINK_TELEFON=
PAY_LINK_PODROSTOK=
PAY_LINK_UROKI=
PAY_LINK_NABOR=
# Доплата до набора для тех, кто уже купил один разбор (набор со скидкой на купленный).
# Пусто — в тексте покажется [ССЫЛКА_ДОПЛАТА]
PAY_LINK_UPGRADE=
# Ссылка на политику обработки персональных данных
POLICY_URL=

# --- ИИ-помощница «Виктория» на GigaChat (необязательно; без ключа отвечает из faq.json) ---
# «Ключ авторизации» из личного кабинета GigaChat API (уже в Base64)
GIGACHAT_AUTH_KEY=
# GIGACHAT_API_PERS — физлица; GIGACHAT_API_B2B / GIGACHAT_API_CORP — ИП и юрлица
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
# Путь к корневому сертификату НУЦ Минцифры (russian_trusted_root_ca.cer → .pem)
GIGACHAT_CA_BUNDLE=
# Переопределить адреса API, если в документации они изменились (см. llm.py)
GIGACHAT_OAUTH_URL=
GIGACHAT_API_BASE=

# --- хранилище и файлы ---
# Пусто = data/bot.sqlite3 рядом с ботом
DB_PATH=
# Пусто = папка files/ рядом с ботом
FILES_DIR=
LEAD_MAGNET_FILE=00-lead-magnet.pdf
FILE_TELEFON=01-telefon.pdf
FILE_PODROSTOK=02-podrostok.pdf
FILE_UROKI=03-uroki.pdf
# Подарок вместо замены для набора: «Карта спокойного вечера»
FILE_GIFT_EVENING=04-podarok.pdf

# --- безопасность ---
MAX_MESSAGE_LEN=1000
# Не больше RATE_LIMIT_COUNT сообщений помощнице за RATE_LIMIT_WINDOW секунд
RATE_LIMIT_COUNT=6
RATE_LIMIT_WINDOW=60
# Журнал вопросов к помощнице (для разбора спорных случаев): 1 — вести, 0 — нет
LOG_DIALOGS=1
DIALOG_LOG_DAYS=30
